# APP
NODE_ENV=development
PORT=3003

# I18N (fa | en)
DEFAULT_LANGUAGE=fa

# DB
MONGO_URL=mongodb://localhost:27017/app
MONGO_DEBUG=true

# JWT
JWT_SECRET=change-me
JWT_AUDIENCE=localhost:3003
JWT_ISSUER=localhost:3003
JWT_EXPIRES_IN=1d

# OPTIONAL INTEGRATIONS (leave blank to disable)
# REDIS_URL=redis://localhost:6379   # also moves rate limiting to Redis
# REDIS_TTL=10800
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# S3_ENDPOINT=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_MAX_FILE_MB=10
# S3_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
# SMS_DRIVER=console                 # console | smsir (smsir only sends in production)
# SMS_API_KEY=
# SMS_SENDER=
# SMS_TEMPLATE=
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=
