{
  "name": "boilerplate-backend",
  "version": "0.0.1",
  "description": "NestJS + MongoDB REST API boilerplate",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "seed": "bun run scripts/seed-admin.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun run dist/main.js",
    "dev": "SERVE_VITE=1 nest start --watch",
    "prod": "bun run build && bun run start:prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test bun test ./test",
    "test:e2e": "bun run test",
    "test:watch": "NODE_ENV=test bun test --watch ./test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/passport": "^12.0.2",
    "express": "^5.3.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.12.2",
    "ms": "^2.1.3",
    "nest-winston": "^2.0.0",
    "nestjs-i18n": "^10.8.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pusher": "^5.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sms-typescript": "^2.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-decorator-position": "^6.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
